function openOfficialSearch(){window.open('https://services.gst.gov.in/services/searchhsnsac','_blank')}
function api(){return esc(localStorage.getItem(APIKEY))}function setStatus(t,s){$('statusText').textContent=t;$('statusDot').className='dot '+s}
async function cloudGet(action,params={}){if(!api())throw new Error('No API');let u=new URL(api());u.searchParams.set('action',action);Object.entries(params).forEach(([k,v])=>u.searchParams.set(k,v));return(await fetch(u.toString(),{redirect:'follow'})).json()}
async function cloudPost(action,data){if(!api())throw new Error('No API');return(await fetch(api(),{method:'POST',redirect:'follow',headers:{'Content-Type':'text/plain;charset=utf-8'},body:JSON.stringify({action,data})})).json()}
function saveApiUrl(){localStorage.setItem(APIKEY,esc($('apiUrl').value));syncFromCloud()}
async function syncFromCloud(){if(!api()){setStatus('Local mode','warn');return}try{setStatus('Connecting…','warn');let r=await cloudGet('bootstrap');if(!r.ok)throw new Error(r.error);if(r.parties?.length)db.parties=r.parties;if(r.gstCodes?.length)db.gstCodes=r.gstCodes;if(Array.isArray(r.invoices))db.invoices=r.invoices;if(Array.isArray(r.invoiceItems))db.invoiceItems=r.invoiceItems;persist();renderSellerSelect();renderBuyerSelect();renderCodeList();setStatus('Google Sheets connected','ok');$('storageInfo').textContent=`Synced ${db.parties.length} parties, ${db.gstCodes.length} GST codes, ${db.invoices.length} invoices.`}catch(e){setStatus('Cloud connection failed','bad');$('storageInfo').textContent='Connection failed. Local data remains available.'}}
async function resetCloudSampleData(){if(!api())return alert('Connect the Google Sheets Web App first.');if(!confirm('This will permanently delete all Parties, GST Codes, Invoices and Invoice Items in the connected Google Sheet, then load only the sample data. Continue?'))return;try{setStatus('Resetting cloud…','warn');let r=await cloudPost('resetSampleData',{});if(!r.ok)throw new Error(r.error||'Reset failed');localStorage.removeItem(STORE);db=defaultData();persist();await syncFromCloud();alert('Cloud data erased and sample data loaded.');}catch(e){setStatus('Reset failed','bad');alert('Reset failed: '+e.message)}}
function exportJson(){let a=document.createElement('a'),blob=new Blob([JSON.stringify(db,null,2)],{type:'application/json'});a.href=URL.createObjectURL(blob);a.download='Universal_Invoice_Backup_'+today()+'.json';a.click();URL.revokeObjectURL(a.href)}
function importJson(e){let f=e.target.files[0];if(!f)return;let r=new FileReader();r.onload=()=>{try{let x=JSON.parse(r.result);if(!x.parties||!x.invoices)throw 0;db=x;if(!db.gstCodes)db.gstCodes=defaultData().gstCodes;if(!db.invoiceItems)db.invoiceItems=[];persist();renderSellerSelect();renderBuyerSelect();renderCodeList();alert('Backup imported.')}catch(err){alert('Invalid backup.')}};r.readAsText(f)}
async function downloadPDF(){updateInvoice();let s=selectedSeller(),fn=`${(s?.name||'Seller').replace(/[^a-z0-9]/gi,'_')}_${($('invoiceNo').value||'Invoice').replace(/[^a-z0-9]/gi,'_')}.pdf`;await html2pdf().set({margin:0,filename:fn,image:{type:'jpeg',quality:.98},html2canvas:{scale:2,useCORS:true,backgroundColor:'#fff'},jsPDF:{unit:'mm',format:'a4',orientation:'portrait'},pagebreak:{mode:['css','legacy']}}).from($('invoicePaper')).save()}
