<style>
:root{--ink:#10243e;--muted:#65758b;--a:#5b21b6;--b:#7c3aed;--bg:#f4f1fb;--line:#ded8ec;--paper:#fff;--ok:#087f5b;--warn:#a15c00;--bad:#b42318;--soft:#faf8ff}
*{box-sizing:border-box}body{margin:0;font-family:Inter,Segoe UI,Arial,sans-serif;background:linear-gradient(135deg,#f1ecfb,#fbfbfe 48%,#eef7f7);color:var(--ink)}
.app{max-width:1540px;margin:16px auto;padding:0 14px 34px}.top{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:14px}.brand h1{margin:0;font-size:27px}.brand p{margin:4px 0 0;color:var(--muted);font-size:12px}.actions{display:flex;gap:7px;flex-wrap:wrap;align-items:center}button,.btn{border:0;border-radius:10px;padding:9px 12px;font-weight:800;cursor:pointer;font:inherit;font-size:12px}.primary{background:linear-gradient(135deg,var(--a),var(--b));color:#fff}.secondary{background:#fff;color:var(--ink);border:1px solid var(--line)}.danger{background:#fff2f1;color:var(--bad);border:1px solid #ffd3cf}.small{padding:6px 9px;font-size:10.5px}.status{display:flex;align-items:center;gap:6px;background:#fff;border:1px solid var(--line);border-radius:99px;padding:6px 9px;font-size:10px}.dot{width:8px;height:8px;border-radius:50%;background:#999}.dot.ok{background:#10b981}.dot.warn{background:#f59e0b}.dot.bad{background:#ef4444}
.layout{display:grid;grid-template-columns:430px 1fr;gap:17px;align-items:start}.panel{background:#fff;border:1px solid var(--line);border-radius:17px;box-shadow:0 12px 30px rgba(50,35,85,.08);position:sticky;top:10px;max-height:calc(100vh - 20px);overflow:auto}.tabs{position:sticky;top:0;z-index:8;background:#fff;padding:8px;display:flex;gap:5px;border-bottom:1px solid var(--line)}.tab{flex:1;background:#f6f3fb;color:#625477;padding:8px 4px;font-size:10.5px}.tab.active{background:#eee7ff;color:#5b21b6}.pane{display:none;padding:14px}.pane.active{display:block}.group{padding:12px 0;border-top:1px solid #eeeaf5}.group:first-child{border-top:0;padding-top:0}.gt{font-size:10.5px;text-transform:uppercase;letter-spacing:.1em;color:var(--a);font-weight:900;margin-bottom:7px}.row{display:grid;grid-template-columns:1fr 1fr;gap:8px}.row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}label{display:block;font-size:10.5px;font-weight:800;color:#46566c;margin:6px 0 3px}input,select,textarea{width:100%;padding:8px 9px;border:1px solid var(--line);border-radius:8px;background:#fff;color:var(--ink);font:inherit;font-size:11.5px}textarea{min-height:54px;resize:vertical}.hint{font-size:9.8px;color:var(--muted);line-height:1.4;margin-top:5px}.notice{padding:8px 9px;border-radius:9px;background:#fff9e8;color:#79500b;border:1px solid #f4dea0;font-size:10.5px;line-height:1.4}.notice.ok{background:#ecfdf5;color:#076649;border-color:#bcebd8}.inline{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}.card{border:1px solid var(--line);border-radius:10px;padding:9px;margin:7px 0;background:#fff}.card b{font-size:11px}.meta{font-size:9.8px;color:var(--muted);margin-top:3px;line-height:1.4}.amt{float:right;font-weight:900;color:var(--a)}
.item-edit{border:1px solid #e6dff2;border-radius:12px;padding:9px;margin:8px 0;background:#fcfbff}.item-edit-head{display:flex;justify-content:space-between;align-items:center}.item-edit-head b{font-size:11px;color:var(--a)}
.paper-wrap{overflow:auto}.paper{width:210mm;min-height:297mm;background:#fff;margin:0 auto;padding:11mm 12mm 10mm;box-shadow:0 14px 38px rgba(37,25,70,.13);position:relative}.head{display:grid;grid-template-columns:1.45fr .85fr;gap:17px;border-bottom:3px solid var(--a);padding-bottom:11px}.seller h2{margin:0;font-size:22px}.tag{display:inline-block;padding:4px 8px;border-radius:99px;margin:6px 0 7px;background:#eee7ff;color:#5b21b6;font-weight:900;font-size:10px;letter-spacing:.06em}.tag.plain{background:#f1f5f9;color:#475569}.seller p,.metabox p{font-size:11.5px;line-height:1.35;margin:2px 0}.metabox{background:var(--soft);border:1px solid var(--line);border-radius:11px;padding:10px}.mg{display:grid;grid-template-columns:1fr 1fr;gap:7px}.k{font-size:9px;text-transform:uppercase;color:var(--muted)}.v{font-size:11px;font-weight:800;margin-top:2px}.party{display:grid;grid-template-columns:1.35fr .65fr;gap:13px;margin:12px 0}.box{border:1px solid var(--line);border-radius:10px;padding:9px}.box h3{font-size:10px;margin:0 0 6px;color:var(--a);text-transform:uppercase;letter-spacing:.08em}.box p{font-size:11px;line-height:1.4;margin:2px 0}.narr{margin:8px 0 10px;border-left:3px solid var(--a);background:#faf8ff;padding:7px 9px;font-size:10.5px;line-height:1.45}table{width:100%;border-collapse:collapse}.items th{background:#f2eef9;color:#293e58;font-size:9.8px;padding:7px 5px;border:1px solid #dcd4eb}.items td{font-size:10.5px;padding:8px 5px;border:1px solid #e0d9ec;vertical-align:top}.num{text-align:right!important;white-space:nowrap}.center{text-align:center!important}.summary{display:grid;grid-template-columns:1fr 275px;gap:15px;margin-top:11px}.words{font-size:10.5px;line-height:1.5}.totals td{padding:5px 7px;font-size:10.5px;border-bottom:1px solid #ece7f4}.totals tr:last-child td{font-size:13px;font-weight:900;border-top:2px solid var(--a);border-bottom:0}.tax-table{margin-top:12px}.tax-table th,.tax-table td{border:1px solid #e0d9ec;padding:5px;font-size:9.2px;text-align:center}.tax-table th{background:#f7f5fb}.foot{display:grid;grid-template-columns:1.35fr .65fr;gap:13px;margin-top:15px;border-top:1px solid var(--line);padding-top:10px}.decl{font-size:9.6px;line-height:1.45;color:#506074}.sign{text-align:right;font-size:10px}.signspace{height:42px}.computer{text-align:center;font-size:9px;color:#718096;margin-top:9px}.copyright{text-align:center;font-size:8.6px;color:#718096;margin-top:5px;padding-top:5px;border-top:1px dashed #e3ddec}.watermark{position:absolute;right:16mm;top:90mm;transform:rotate(-31deg);font-size:42px;font-weight:900;color:rgba(91,33,182,.035);pointer-events:none}
@media(max-width:1150px){.layout{grid-template-columns:1fr}.panel{position:relative;max-height:none}.top{align-items:flex-start;flex-direction:column}}@media print{body{background:#fff}.top,.panel{display:none!important}.app{margin:0;padding:0;max-width:none}.layout{display:block}.paper-wrap{overflow:visible}.paper{box-shadow:none;margin:0;width:210mm;min-height:297mm}}
</style></head>
<body><div class="app">
<div class="top"><div class="brand"><h1>SPH Universal GST Invoice Manager</h1><p>Shared party master · seller-wise serials · goods & services · HSN/SAC item master · Google Sheets storage</p><p><b>Created by SPH &amp; Associates, Chartered Accountants</b></p></div><div class="actions"><div class="status"><span id="statusDot" class="dot warn"></span><span id="statusText">Local mode</span></div><button class="secondary" onclick="window.print()">Print</button><button class="secondary" onclick="downloadExcel()">Excel</button><button class="primary" onclick="downloadPDF()">PDF</button></div></div>
<div class="layout"><aside class="panel"><div class="tabs"><button class="tab active" onclick="showTab('invoice',this)">Invoice</button><button class="tab" onclick="showTab('parties',this)">Parties</button><button class="tab" onclick="showTab('codes',this)">HSN/SAC</button><button class="tab" onclick="showTab('history',this)">History</button><button class="tab" onclick="showTab('storage',this)">Storage</button></div>
<div id="tab-invoice" class="pane active">
<div class="group"><div class="gt">Seller & Numbering</div><label>Seller</label><select id="sellerSelect"></select><div id="sellerNotice" class="notice ok" style="margin-top:7px"></div><div class="row"><div><label>Financial Year</label><select id="fy"></select></div><div><label>Invoice No.</label><input id="invoiceNo" readonly></div></div><div class="row"><div><label>Invoice Date</label><input id="invoiceDate" type="date"></div><div><label>Payment Terms</label><input id="paymentTerms" value="Due on receipt"></div></div></div>
<div class="group"><div class="gt">Buyer — Shared Across All Sellers</div><label>Select Any Saved Party as Buyer</label><select id="buyerSelect"></select><div class="hint">Seller records are also available here as buyers. Buyer master is global, not seller-restricted.</div><label>Buyer Name</label><input id="buyerName"><label>Buyer Address</label><textarea id="buyerAddress"></textarea><div class="row"><div><label>GSTIN (optional)</label><input id="buyerGstin"></div><div><label>PAN (optional)</label><input id="buyerPan"></div></div><div class="row"><div><label>State</label><input id="buyerState" value="Delhi"></div><div><label>State Code</label><input id="buyerStateCode" value="07"></div></div><div class="inline"><button class="secondary small" onclick="saveBuyerFromInvoice()">Save / Update Party</button><button class="secondary small" onclick="clearBuyer()">New Buyer</button></div></div>
<div class="group"><div class="gt">Invoice Details</div><div class="row"><div><label>Place of Supply</label><input id="pos" value="Delhi"></div><div><label>State Code</label><input id="posCode" value="07"></div></div><div class="row"><div><label>Tax Type</label><select id="taxType"><option value="intra">Intra-State (CGST + SGST)</option><option value="inter">Inter-State (IGST)</option></select></div><div><label>Reverse Charge</label><select id="rcm"><option>No</option><option>Yes</option></select></div></div><label>Reference / PO / Agreement No.</label><input id="reference"><label>Common Narration</label><textarea id="commonNarration">Supply as per agreed terms and conditions.</textarea><label>Notes</label><textarea id="notes"></textarea></div>
<div class="group"><div class="gt">Line Items</div><div id="itemEditors"></div><div class="inline"><button class="primary small" onclick="addItem()">+ Add Item</button><button class="secondary small" onclick="addItem('Service')">+ Service</button><button class="secondary small" onclick="addItem('Goods')">+ Goods</button></div><div class="hint">Choose Goods → HSN. Choose Service → SAC. Quantity, UQC, rate and GST are calculated line-wise.</div></div>
<div class="group"><button class="primary" style="width:100%" onclick="saveInvoice()">Save Invoice to Google Sheets / Local Records</button></div>
</div>
<div id="tab-parties" class="pane"><div class="group"><div class="gt">Unified Party Master</div><input type="hidden" id="partyId"><label>Party Name</label><input id="partyName"><label>Address</label><textarea id="partyAddress"></textarea><div class="row"><div><label>Can Act As</label><select id="partyRole"><option>Both</option><option>Seller</option><option>Buyer</option></select></div><div><label>GST Registered?</label><select id="partyRegistered"><option value="Yes">Yes</option><option value="No">No</option></select></div></div><div class="row"><div><label>GSTIN</label><input id="partyGstin"></div><div><label>PAN</label><input id="partyPan"></div></div><div class="row"><div><label>State</label><input id="partyState" value="Delhi"></div><div><label>State Code</label><input id="partyStateCode" value="07"></div></div><div class="row"><div><label>LLPIN / CIN / Other ID</label><input id="partyCin"></div><div><label>Seller Invoice Prefix</label><input id="partyPrefix" value="{FY}/"></div></div><div class="inline"><button class="primary small" onclick="saveParty()">Save Party</button><button class="secondary small" onclick="newParty()">New Party</button></div><div class="hint">A party marked “Both” can be selected either as seller or buyer. Seller numbering stays independent for each seller.</div></div><div class="group"><div class="gt">Saved Parties</div><input id="partySearch" placeholder="Search party / GSTIN / PAN" oninput="renderPartyList()"><div id="partyList"></div></div></div>
<div id="tab-codes" class="pane"><div class="notice">Sample HSN/SAC entries are for demonstration. Confirm classification, rate, exemptions and transaction-specific conditions before issuing a live invoice.</div><div class="group"><div class="gt">GST Item / HSN / SAC Master</div><input type="hidden" id="codeId"><div class="row"><div><label>Type</label><select id="codeType"><option>Service</option><option>Goods</option></select></div><div><label>HSN / SAC Code</label><input id="codeCode"></div></div><label>Item / Service Name</label><input id="codeName"><label>Default Narration</label><textarea id="codeNarration"></textarea><div class="row"><div><label>Default UQC</label><input id="codeUqc" placeholder="NOS / UNIT / NA"></div><div><label>Default GST %</label><input id="codeGst" type="number" step="0.01" value="18"></div></div><div class="inline"><button class="primary small" onclick="saveCode()">Save Code</button><button class="secondary small" onclick="newCode()">New Code</button><button class="secondary small" onclick="openOfficialSearch()">Official GST HSN/SAC Search ↗</button></div><div class="notice" style="margin-top:9px">The app includes a practical preloaded GST code master and lets you add/import your own master. Verify unusual or rate-sensitive classifications from the official GST/CBIC source before billing.</div></div><div class="group"><div class="gt">Search Code Master</div><input id="codeSearch" placeholder="Search code / item / service" oninput="renderCodeList()"><div id="codeList"></div></div></div>
<div id="tab-history" class="pane"><div class="group"><div class="gt">Seller-wise Invoice History</div><input id="historySearch" placeholder="Search invoice / buyer / item" oninput="renderHistory()"><div id="historyList"></div></div></div>
<div id="tab-storage" class="pane"><div class="group"><div class="gt">Google Sheets Connection</div><div class="notice">Deploy the supplied Apps Script as a Web App and paste its <b>/exec</b> URL here. This sample edition starts with a clean database containing 10 dummy parties and 7 GST-code samples. Use reset only when you intentionally want to erase cloud records.</div><label>Apps Script Web App URL</label><input id="apiUrl" placeholder="https://script.google.com/macros/s/.../exec"><div class="inline"><button class="primary small" onclick="saveApiUrl()">Save & Connect</button><button class="secondary small" onclick="syncFromCloud()">Refresh</button><button class="danger small" onclick="resetCloudSampleData()">Erase Cloud & Load Sample Data</button></div><div id="storageInfo" class="hint"></div></div><div class="group"><div class="gt">Backup</div><div class="inline"><button class="secondary small" onclick="exportJson()">Export JSON</button><button class="secondary small" onclick="document.getElementById('jsonImport').click()">Import JSON</button><input id="jsonImport" type="file" accept="application/json" hidden onchange="importJson(event)"></div></div></div>
</aside>
<main class="paper-wrap"><section class="paper" id="invoicePaper"><div class="watermark" id="watermark">INVOICE</div><div class="head"><div class="seller"><h2 id="oSellerName"></h2><span id="invoiceTag" class="tag">TAX INVOICE</span><p id="oSellerAddress"></p><p id="oSellerGst"></p><p id="oSellerLegal"></p></div><div class="metabox"><div class="mg"><div><div class="k">Invoice No.</div><div class="v" id="oInvoiceNo"></div></div><div><div class="k">Date</div><div class="v" id="oDate"></div></div><div><div class="k">Place of Supply</div><div class="v" id="oPos"></div></div><div><div class="k">Payment Terms</div><div class="v" id="oTerms"></div></div><div><div class="k">Reverse Charge</div><div class="v" id="oRcm"></div></div><div><div class="k">Reference</div><div class="v" id="oReference">—</div></div></div></div></div>
<div class="party"><div class="box"><h3>Bill To</h3><p><b id="oBuyerName"></b></p><p id="oBuyerAddress"></p><p id="oBuyerGstin"></p><p><b>State:</b> <span id="oBuyerState"></span></p></div><div class="box"><h3>Tax Details</h3><p id="oTaxType"></p><p id="oRcm2"></p></div></div><div id="oNarration" class="narr"></div>
<table class="items"><thead><tr><th style="width:5%">#</th><th>Description</th><th style="width:12%">HSN/SAC</th><th style="width:8%">Qty</th><th style="width:8%">UQC</th><th style="width:12%" class="num">Rate</th><th style="width:14%" class="num">Taxable</th><th style="width:8%">GST%</th></tr></thead><tbody id="oItems"></tbody></table>
<div class="summary"><div class="words"><span class="tag" style="margin:0">Amount Chargeable (in words)</span><strong id="oWords"></strong><div id="oNotes" style="margin-top:8px;color:#59697b"></div></div><table class="totals"><tr><td>Taxable Value</td><td class="num" id="tTaxable"></td></tr><tr id="cgstRow"><td>CGST</td><td class="num" id="tCgst"></td></tr><tr id="sgstRow"><td>SGST</td><td class="num" id="tSgst"></td></tr><tr id="igstRow"><td>IGST</td><td class="num" id="tIgst"></td></tr><tr><td>Invoice Total</td><td class="num" id="tGrand"></td></tr></table></div>
<table class="tax-table"><thead><tr><th>HSN/SAC</th><th>Taxable Value</th><th>GST Rate</th><th>CGST</th><th>SGST</th><th>IGST</th><th>Total Tax</th></tr></thead><tbody id="taxBody"></tbody></table>
<div class="foot"><div class="decl"><b>Declaration</b><br>We declare that this invoice shows the actual value of the goods/services described and that all particulars are true and correct.</div><div class="sign"><b id="signSeller"></b><div class="signspace"></div>Authorised Signatory</div></div><div class="computer" id="computerText"></div><div class="copyright">Created by <b>SPH &amp; Associates, Chartered Accountants</b> · © 2026 SPH &amp; Associates. All rights reserved. Proprietary invoice software/layout; unauthorised copying, redistribution or commercial reproduction is prohibited.</div></section></main></div></div>
<script>
const $=id=>document.getElementById(id), STORE='sphUniversalInvoiceDB_sample_v6', APIKEY='invoiceManagerApiUrl_v1';
let db={parties:[],gstCodes:[],invoices:[],invoiceItems:[]},currentBuyerId='',lineItems=[];
const esc=v=>String(v??'').trim(),uid=p=>p+'_'+Date.now()+'_'+Math.random().toString(36).slice(2,7),today=()=>new Date().toISOString().slice(0,10),money=n=>(Number(n)||0).toLocaleString('en-IN',{minimumFractionDigits:2,maximumFractionDigits:2}),fmtDate=d=>d?new Date(d+'T00:00:00').toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'}):'';
function currentFY(d=new Date()){let y=d.getFullYear(),m=d.getMonth()+1;return m>=4?`${y}-${String(y+1).slice(-2)}`:`${y-1}-${String(y).slice(-2)}`}
function fyOptions(){let y=new Date().getFullYear();return Array.from({length:10},(_,i)=>`${y-4+i}-${String(y-3+i).slice(-2)}`)}
const seedCodes=[
['Goods','2523','Portland cement and similar hydraulic cements','Supply of cement / hydraulic cement as per purchase order or delivery challan.','BAG',28],
['Goods','7214','Bars and rods of iron or non-alloy steel (TMT / reinforcement steel)','Supply of reinforcement steel / TMT bars as per order and actual weight.','KGS',18],
['Goods','2517','Pebbles, gravel, broken or crushed stone used as concrete aggregate','Supply of stone aggregate / crushed stone as per order and weighment.','MT',5],
['Goods','69041000','Ceramic building bricks','Supply of building bricks as per order / delivery challan.','NOS',12],
['Service','997222','Real estate agency services on a fee or commission basis','Brokerage / real estate agency services rendered as per agreed terms.','NA',18],
['Service','995419','Other construction services of residential buildings','Construction services rendered as per work order / contract and certified work.','NA',18],
['Service','995429','General construction services of other civil engineering works n.e.c.','Civil / general construction services rendered as per work order / contract.','NA',18]
];
const sampleParties=[
{id:'p01',name:'Aarav Buildtech Private Limited',address:'Plot 21, Okhla Industrial Estate, Phase III, New Delhi-110020',role:'Both',registered:'Yes',gstin:'07AAAAA1111A1Z1',pan:'AAAAA1111A',state:'Delhi',stateCode:'07',cin:'U45200DL2020PTC000001',prefix:'AB/{FY}/'},
{id:'p02',name:'Bharat Cement Traders',address:'18, Sector 18, Gurugram, Haryana-122015',role:'Both',registered:'Yes',gstin:'06BBBBB2222B1Z2',pan:'BBBBB2222B',state:'Haryana',stateCode:'06',cin:'',prefix:'BCT/{FY}/'},
{id:'p03',name:'Capital Steel & Infra LLP',address:'B-44, Sahibabad Industrial Area, Ghaziabad, Uttar Pradesh-201010',role:'Both',registered:'Yes',gstin:'09CCCCC3333C1Z3',pan:'CCCCC3333C',state:'Uttar Pradesh',stateCode:'09',cin:'AAX-0001',prefix:'CSI/{FY}/'},
{id:'p04',name:'Delhi Stone Aggregates',address:'Khasra 112, Alipur, Delhi-110036',role:'Both',registered:'Yes',gstin:'07DDDDD4444D1Z4',pan:'DDDDD4444D',state:'Delhi',stateCode:'07',cin:'',prefix:'DSA/{FY}/'},
{id:'p05',name:'Elite Realty Services Private Limited',address:'C-9, Vasant Kunj, New Delhi-110070',role:'Both',registered:'Yes',gstin:'07EEEEE5555E1Z5',pan:'EEEEE5555E',state:'Delhi',stateCode:'07',cin:'U70100DL2021PTC000005',prefix:'ERS/{FY}/'},
{id:'p06',name:'Frontier Civil Works',address:'SCO 14, Sector 17, Faridabad, Haryana-121002',role:'Both',registered:'Yes',gstin:'06FFFFF6666F1Z6',pan:'FFFFF6666F',state:'Haryana',stateCode:'06',cin:'',prefix:'FCW/{FY}/'},
{id:'p07',name:'Greenline Construction Solutions LLP',address:'D-82, Sector 63, Noida, Uttar Pradesh-201301',role:'Both',registered:'Yes',gstin:'09GGGGG7777G1Z7',pan:'GGGGG7777G',state:'Uttar Pradesh',stateCode:'09',cin:'AAY-0007',prefix:'GCS/{FY}/'},
{id:'p08',name:'Rohit Mehra',address:'Flat 302, Maple Residency, Saket, New Delhi-110017',role:'Buyer',registered:'No',gstin:'',pan:'',state:'Delhi',stateCode:'07',cin:'',prefix:'{FY}/'},
{id:'p09',name:'Neha Kapoor',address:'House 48, DLF Phase II, Gurugram, Haryana-122002',role:'Buyer',registered:'No',gstin:'',pan:'',state:'Haryana',stateCode:'06',cin:'',prefix:'{FY}/'},
{id:'p10',name:'Arjun Singh',address:'Villa 9, Sector 50, Noida, Uttar Pradesh-201301',role:'Buyer',registered:'No',gstin:'',pan:'',state:'Uttar Pradesh',stateCode:'09',cin:'',prefix:'{FY}/'}
];
function defaultData(){let parties=sampleParties.map(x=>({...x}));let gstCodes=seedCodes.map((x,i)=>({id:'sample_code_'+(i+1),type:x[0],code:x[1],name:x[2],narration:x[3],uqc:x[4],gst:x[5]}));return{parties,gstCodes,invoices:[],invoiceItems:[]}}
function loadLocal(){try{const x=JSON.parse(localStorage.getItem(STORE));db=x&&x.parties?x:defaultData()}catch(e){db=defaultData()}if(!db.gstCodes?.length)db.gstCodes=defaultData().gstCodes;if(!db.invoiceItems)db.invoiceItems=[];persist()}
function persist(){localStorage.setItem(STORE,JSON.stringify(db))}
function showTab(n,btn){document.querySelectorAll('.pane').forEach(x=>x.classList.remove('active'));document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));$('tab-'+n).classList.add('active');btn?.classList.add('active');if(n==='parties')renderPartyList();if(n==='codes')renderCodeList();if(n==='history')renderHistory()}
function sellers(){return db.parties.filter(p=>p.role==='Seller'||p.role==='Both')}function selectedSeller(){return db.parties.find(p=>p.id===$('sellerSelect').value)}
function renderSellerSelect(){let old=$('sellerSelect').value,arr=sellers();$('sellerSelect').innerHTML=arr.map(s=>`<option value="${s.id}">${s.name}${s.registered==='Yes'?' · GST':' · Unregistered'}</option>`).join('');if(arr.some(s=>s.id===old))$('sellerSelect').value=old;else if(arr.length)$('sellerSelect').value=arr[0].id;onSellerChange()}
function renderBuyerSelect(){let old=$('buyerSelect').value,arr=[...db.parties].sort((a,b)=>a.name.localeCompare(b.name));$('buyerSelect').innerHTML='<option value="">— New / Select Any Saved Party —</option>'+arr.map(p=>`<option value="${p.id}">${p.name}${p.role==='Seller'||p.role==='Both'?' · Seller':''}</option>`).join('');if(arr.some(p=>p.id===old))$('buyerSelect').value=old}
function onSellerChange(){const s=selectedSeller();if(!s)return;renderBuyerSelect();$('pos').value=s.state||'';$('posCode').value=s.stateCode||'';$('sellerNotice').className='notice '+(s.registered==='Yes'?'ok':'');$('sellerNotice').innerHTML=s.registered==='Yes'?`GST registered seller · document: <b>Tax Invoice</b> · ${s.gstin||'GSTIN not entered'}`:`Unregistered seller · document: <b>Invoice</b> · GST will be forced to zero.`;nextInvoiceNumber();updateInvoice();renderHistory()}
function onBuyerChange(){let p=db.parties.find(x=>x.id===$('buyerSelect').value);if(!p)return clearBuyer(false);currentBuyerId=p.id;$('buyerName').value=p.name||'';$('buyerAddress').value=p.address||'';$('buyerGstin').value=p.gstin||'';$('buyerPan').value=p.pan||'';$('buyerState').value=p.state||'';$('buyerStateCode').value=p.stateCode||'';updateInvoice()}
function clearBuyer(reset=true){currentBuyerId='';['buyerName','buyerAddress','buyerGstin','buyerPan'].forEach(id=>$(id).value='');if(reset){$('buyerState').value=selectedSeller()?.state||'Delhi';$('buyerStateCode').value=selectedSeller()?.stateCode||'07';$('buyerSelect').value=''}updateInvoice()}
async function saveBuyerFromInvoice(){let name=esc($('buyerName').value);if(!name)return alert('Enter buyer name.');let p=db.parties.find(x=>x.id===currentBuyerId);if(!p){p={id:uid('party'),role:'Buyer',registered:$('buyerGstin').value?'Yes':'No',prefix:'{FY}/'};db.parties.push(p);currentBuyerId=p.id}Object.assign(p,{name,address:esc($('buyerAddress').value),gstin:esc($('buyerGstin').value),pan:esc($('buyerPan').value),state:esc($('buyerState').value),stateCode:esc($('buyerStateCode').value)});if(p.role==='Seller')p.role='Both';persist();try{await cloudPost('saveParty',p)}catch(e){}renderBuyerSelect();$('buyerSelect').value=p.id;alert('Party saved in shared master. It can be reused by every seller.')}
function calcNext(sid,fy){let nums=db.invoices.filter(i=>i.sellerId===sid&&i.fy===fy).map(i=>Number(i.sequence)||0);return(Math.max(0,...nums)+1)}
async function nextInvoiceNumber(){const s=selectedSeller();if(!s)return;let fy=$('fy').value||currentFY(),seq=calcNext(s.id,fy),prefix=s.prefix||'{FY}/';$('invoiceNo').value=prefix.replace(/\{FY\}/g,fy)+String(seq).padStart(3,'0');if(api())try{let r=await cloudGet('nextInvoice',{sellerId:s.id,fy});if(r.ok)$('invoiceNo').value=r.invoiceNo}catch(e){}}
function addItem(type='Service',data={}){lineItems.push({id:data.id||uid('line'),type:data.type||type,codeId:data.codeId||'',code:data.code||'',description:data.description||'',narration:data.narration||'',qty:Number(data.qty??1),uqc:data.uqc||((data.type||type)==='Goods'?'NOS':'NA'),rate:Number(data.rate||0),gst:Number(data.gst??18)});renderItemEditors();updateInvoice()}
function removeItem(id){lineItems=lineItems.filter(x=>x.id!==id);if(!lineItems.length)addItem('Service');else{renderItemEditors();updateInvoice()}}
function codeOptions(type,selected=''){let arr=db.gstCodes.filter(c=>c.type===type).sort((a,b)=>a.name.localeCompare(b.name));return '<option value="">— Select from Master —</option>'+arr.map(c=>`<option value="${c.id}" ${c.id===selected?'selected':''}>${c.code} · ${c.name}</option>`).join('')}
function renderItemEditors(){let root=$('itemEditors');root.innerHTML=lineItems.map((it,idx)=>`<div class="item-edit"><div class="item-edit-head"><b>Line ${idx+1} · ${it.type}</b>${lineItems.length>1?`<button class="danger small" onclick="removeItem('${it.id}')">Remove</button>`:''}</div><div class="row"><div><label>Type</label><select onchange="changeItemType('${it.id}',this.value)"><option ${it.type==='Goods'?'selected':''}>Goods</option><option ${it.type==='Service'?'selected':''}>Service</option></select></div><div><label>${it.type==='Goods'?'HSN':'SAC'} Master</label><select onchange="selectCode('${it.id}',this.value)">${codeOptions(it.type,it.codeId)}</select></div></div><label>Description</label><input value="${String(it.description).replace(/&/g,'&amp;').replace(/"/g,'&quot;')}" oninput="setItem('${it.id}','description',this.value)"><div class="row3"><div><label>${it.type==='Goods'?'HSN':'SAC'} Code</label><input value="${it.code}" oninput="setItem('${it.id}','code',this.value)"></div><div><label>Qty</label><input type="number" step="0.001" value="${it.qty}" oninput="setItem('${it.id}','qty',this.value,true)"></div><div><label>UQC</label><input value="${it.uqc}" oninput="setItem('${it.id}','uqc',this.value)"></div></div><div class="row"><div><label>Rate (₹)</label><input type="number" step="0.01" value="${it.rate}" oninput="setItem('${it.id}','rate',this.value,true)"></div><div><label>GST %</label><input type="number" step="0.01" value="${it.gst}" oninput="setItem('${it.id}','gst',this.value,true)"></div></div><label>Line Narration (optional)</label><input value="${String(it.narration).replace(/&/g,'&amp;').replace(/"/g,'&quot;')}" oninput="setItem('${it.id}','narration',this.value)"></div>`).join('')}
function changeItemType(id,type){let it=lineItems.find(x=>x.id===id);it.type=type;it.codeId='';it.code='';it.description='';it.narration='';it.uqc=type==='Goods'?'NOS':'NA';renderItemEditors();autoNarration();updateInvoice()}
function selectCode(id,cid){let it=lineItems.find(x=>x.id===id),c=db.gstCodes.find(x=>x.id===cid);if(!it||!c)return;Object.assign(it,{codeId:c.id,code:c.code,description:c.name,narration:c.narration,uqc:c.uqc|| (c.type==='Goods'?'NOS':'NA'),gst:Number(c.gst)||0});renderItemEditors();autoNarration();updateInvoice()}
function setItem(id,k,v,num=false){let it=lineItems.find(x=>x.id===id);if(!it)return;it[k]=num?(Number(v)||0):v;if(k==='description'||k==='code')autoNarration();updateInvoice()}
function autoNarration(){if(!$('commonNarration'))return;let types=[...new Set(lineItems.map(i=>i.type))],txt=types.length===1?(types[0]==='Goods'?'Supply of goods as per order / agreed terms and conditions.':'Services rendered as per agreed scope / terms and conditions.'):'Supply of goods and services as per agreed terms and conditions.';$('commonNarration').value=txt}
function calc(){let s=selectedSeller(),registered=s?.registered==='Yes',type=$('taxType').value,items=lineItems.map(i=>{let taxable=(Number(i.qty)||0)*(Number(i.rate)||0),gst=registered?(Number(i.gst)||0):0,cgst=type==='intra'?taxable*gst/200:0,sgst=cgst,igst=type==='inter'?taxable*gst/100:0;return{...i,taxable,gst,cgst,sgst,igst,total:taxable+cgst+sgst+igst}});let sum=k=>items.reduce((a,x)=>a+(Number(x[k])||0),0);return{registered,type,items,taxable:sum('taxable'),cgst:sum('cgst'),sgst:sum('sgst'),igst:sum('igst'),total:sum('total')}}
function updateInvoice(){let s=selectedSeller();if(!s)return;let c=calc(),reg=c.registered,title=reg?'TAX INVOICE':'INVOICE';$('invoiceTag').textContent=title;$('invoiceTag').className='tag '+(reg?'':'plain');$('watermark').textContent=title;$('oSellerName').textContent=s.name||'';$('oSellerAddress').textContent=s.address||'';$('oSellerGst').innerHTML=reg?`<b>GSTIN:</b> ${s.gstin||'—'} · <b>State:</b> ${s.state||''} (${s.stateCode||''})`:`<b>GST:</b> Unregistered · <b>State:</b> ${s.state||''} (${s.stateCode||''})`;$('oSellerLegal').innerHTML=[s.pan?`<b>PAN:</b> ${s.pan}`:'',s.cin?`<b>LLPIN/CIN:</b> ${s.cin}`:''].filter(Boolean).join(' · ');$('oInvoiceNo').textContent=$('invoiceNo').value||'—';$('oDate').textContent=fmtDate($('invoiceDate').value);$('oPos').textContent=`${$('pos').value||'—'} (${$('posCode').value||'—'})`;$('oTerms').textContent=$('paymentTerms').value||'—';$('oRcm').textContent=$('rcm').value;$('oReference').textContent=$('reference').value||'—';$('oBuyerName').textContent=$('buyerName').value||'—';$('oBuyerAddress').textContent=$('buyerAddress').value||'';$('oBuyerGstin').innerHTML=$('buyerGstin').value?`<b>GSTIN:</b> ${$('buyerGstin').value}`:'GSTIN: Not provided';$('oBuyerState').textContent=`${$('buyerState').value||''} (${$('buyerStateCode').value||''})`;$('oTaxType').textContent=reg?(c.type==='intra'?'CGST + SGST':'IGST'):'GST not charged';$('oRcm2').textContent=`Reverse Charge: ${$('rcm').value}`;$('oNarration').textContent=$('commonNarration').value||'';$('oItems').innerHTML=c.items.map((i,n)=>`<tr><td class="center">${n+1}</td><td><b>${i.description||'—'}</b>${i.narration?`<div style="font-size:9px;color:#66758a;margin-top:3px">${i.narration}</div>`:''}<div style="font-size:8.8px;color:#806f95;margin-top:2px">${i.type}</div></td><td class="center">${i.code||'—'}</td><td class="center">${i.qty}</td><td class="center">${i.uqc||'—'}</td><td class="num">${money(i.rate)}</td><td class="num">${money(i.taxable)}</td><td class="center">${reg?i.gst:0}%</td></tr>`).join('');$('tTaxable').textContent='₹ '+money(c.taxable);$('tCgst').textContent='₹ '+money(c.cgst);$('tSgst').textContent='₹ '+money(c.sgst);$('tIgst').textContent='₹ '+money(c.igst);$('tGrand').textContent='₹ '+money(c.total);$('cgstRow').style.display=reg&&c.type==='intra'?'table-row':'none';$('sgstRow').style.display=reg&&c.type==='intra'?'table-row':'none';$('igstRow').style.display=reg&&c.type==='inter'?'table-row':'none';$('oWords').textContent=numberToWordsIndian(Math.round(c.total))+' Only';$('oNotes').textContent=$('notes').value||'';$('taxBody').innerHTML=c.items.map(i=>`<tr><td>${i.code||'—'}</td><td>${money(i.taxable)}</td><td>${reg?i.gst:0}%</td><td>${money(i.cgst)}</td><td>${money(i.sgst)}</td><td>${money(i.igst)}</td><td>${money(i.cgst+i.sgst+i.igst)}</td></tr>`).join('');$('signSeller').textContent='For '+(s.name||'Seller');$('computerText').textContent=reg?'This is a computer generated Tax Invoice':'This is a computer generated Invoice — GST not charged by seller'}
function numberToWordsIndian(n){n=Math.floor(Number(n)||0);if(n===0)return'INR Zero';const a=['','One','Two','Three','Four','Five','Six','Seven','Eight','Nine','Ten','Eleven','Twelve','Thirteen','Fourteen','Fifteen','Sixteen','Seventeen','Eighteen','Nineteen'],b=['','','Twenty','Thirty','Forty','Fifty','Sixty','Seventy','Eighty','Ninety'];function w(x){if(x<20)return a[x];if(x<100)return b[Math.floor(x/10)]+(x%10?' '+a[x%10]:'');if(x<1000)return a[Math.floor(x/100)]+' Hundred'+(x%100?' '+w(x%100):'');return''}let out=[];let crore=Math.floor(n/10000000);if(crore){out.push(w(crore)+' Crore');n%=10000000}let lakh=Math.floor(n/100000);if(lakh){out.push(w(lakh)+' Lakh');n%=100000}let th=Math.floor(n/1000);if(th){out.push(w(th)+' Thousand');n%=1000}if(n)out.push(w(n));return'INR '+out.join(' ')}
function invoicePayload(){let s=selectedSeller(),c=calc();return{id:uid('inv'),sellerId:s.id,sellerName:s.name,fy:$('fy').value,sequence:calcNext(s.id,$('fy').value),invoiceNo:$('invoiceNo').value,invoiceDate:$('invoiceDate').value,paymentTerms:$('paymentTerms').value,buyerId:currentBuyerId,buyerName:$('buyerName').value,buyerAddress:$('buyerAddress').value,buyerGstin:$('buyerGstin').value,buyerPan:$('buyerPan').value,buyerState:$('buyerState').value,buyerStateCode:$('buyerStateCode').value,pos:$('pos').value,posCode:$('posCode').value,taxType:c.registered?c.type:'none',rcm:$('rcm').value,reference:$('reference').value,commonNarration:$('commonNarration').value,notes:$('notes').value,taxable:c.taxable,cgst:c.cgst,sgst:c.sgst,igst:c.igst,total:c.total,documentType:c.registered?'Tax Invoice':'Invoice',createdAt:new Date().toISOString(),items:c.items.map((x,n)=>({id:uid('item'),lineNo:n+1,type:x.type,codeId:x.codeId,hsnSac:x.code,description:x.description,narration:x.narration,qty:x.qty,uqc:x.uqc,rate:x.rate,gstRate:x.gst,taxable:x.taxable,cgst:x.cgst,sgst:x.sgst,igst:x.igst,total:x.total}))}}
async function saveInvoice(){let s=selectedSeller();if(!s)return alert('Select seller.');if(!esc($('buyerName').value))return alert('Enter buyer.');if(!lineItems.length)return alert('Add at least one item.');let inv=invoicePayload();if(inv.taxable<=0&&!confirm('Taxable value is zero. Save anyway?'))return;try{if(api()){setStatus('Syncing…','warn');let r=await cloudPost('saveInvoice',inv);if(!r.ok)throw new Error(r.error||'Save failed');inv.invoiceNo=r.invoiceNo;inv.sequence=Number(r.sequence)||inv.sequence;$('invoiceNo').value=inv.invoiceNo;setStatus('Google Sheets connected','ok')}}catch(e){setStatus('Cloud error · local backup saved','bad')}db.invoices.push({...inv,items:undefined});inv.items.forEach(x=>db.invoiceItems.push({...x,invoiceId:inv.id}));persist();renderHistory();await nextInvoiceNumber();alert('Invoice saved successfully. Seller-wise next serial is ready.')}
function renderHistory(){if(!$('historyList'))return;let sid=selectedSeller()?.id,q=esc($('historySearch')?.value).toLowerCase(),arr=db.invoices.filter(i=>i.sellerId===sid).filter(i=>!q||[i.invoiceNo,i.buyerName,i.reference,i.commonNarration].join(' ').toLowerCase().includes(q)).sort((a,b)=>String(b.createdAt).localeCompare(String(a.createdAt)));$('historyList').innerHTML=arr.length?arr.map(i=>`<div class="card"><span class="amt">₹ ${money(i.total)}</span><b>${i.invoiceNo}</b><div class="meta">${fmtDate(i.invoiceDate)} · ${i.documentType}<br>${i.buyerName||'—'}</div><div class="inline"><button class="secondary small" onclick="loadInvoice('${i.id}')">Load</button></div></div>`).join(''):'<div class="hint">No saved invoice for this seller.</div>'}
function loadInvoice(id){let i=db.invoices.find(x=>x.id===id);if(!i)return;$('sellerSelect').value=i.sellerId;onSellerChange();$('fy').value=i.fy;$('invoiceNo').value=i.invoiceNo;$('invoiceDate').value=i.invoiceDate;$('paymentTerms').value=i.paymentTerms||'';$('buyerName').value=i.buyerName||'';$('buyerAddress').value=i.buyerAddress||'';$('buyerGstin').value=i.buyerGstin||'';$('buyerPan').value=i.buyerPan||'';$('buyerState').value=i.buyerState||'';$('buyerStateCode').value=i.buyerStateCode||'';currentBuyerId=i.buyerId||'';$('pos').value=i.pos||'';$('posCode').value=i.posCode||'';$('taxType').value=i.taxType==='inter'?'inter':'intra';$('rcm').value=i.rcm||'No';$('reference').value=i.reference||'';$('commonNarration').value=i.commonNarration||'';$('notes').value=i.notes||'';lineItems=db.invoiceItems.filter(x=>x.invoiceId===id).map(x=>({id:uid('line'),type:x.type,codeId:x.codeId||'',code:x.hsnSac,description:x.description,narration:x.narration,qty:Number(x.qty),uqc:x.uqc,rate:Number(x.rate),gst:Number(x.gstRate)}));if(!lineItems.length)addItem();else renderItemEditors();updateInvoice();showTab('invoice',document.querySelector('.tab'))}
